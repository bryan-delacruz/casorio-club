# Clerk — autenticación (correo + código de 6 dígitos, sin contraseña).
# Consíguelas en https://dashboard.clerk.com → tu app → API keys,
# o crea una app de desarrollo con: npx clerk@latest init
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Rutas de auth propias de la app. No son secretos.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/entrar
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/crear-cuenta
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/mi-boda
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/mi-boda
