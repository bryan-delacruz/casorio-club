# Clerk — autenticación (correo + código de 6 dígitos, sin contraseña).
# Consíguelas en https://dashboard.clerk.com → tu app → API keys,
# o crea una app de desarrollo con: npx clerk@latest init
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Rutas de auth propias de la app. No son secretos.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/entrar
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/crear-cuenta
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/mi-boda
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/mi-boda

# Neon Postgres.
DATABASE_URL=

# --- Integración con Bernie Wallet (docs/integracion-bernie.md) ---
# Sin estas variables la integración no aparece.
BERNIE_URL=https://bernie-wallet.vercel.app
BERNIE_SUPABASE_URL=https://<project-ref>.supabase.co
# Cliente OAuth registrado en Supabase de Bernie (confidencial).
BERNIE_OAUTH_CLIENT_ID=
BERNIE_OAUTH_CLIENT_SECRET=
# Lo imprime una vez el script de registro de Bernie (whsec_...).
BERNIE_WEBHOOK_SECRET=
# AES-256-GCM, 32 bytes base64: openssl rand -base64 32
BERNIE_TOKEN_ENCRYPTION_KEY=

# Webhooks de Clerk (organizationMembership.deleted, organization.deleted).
CLERK_WEBHOOK_SIGNING_SECRET=
